{
  "name": "ep133-studio",
  "version": "0.10.0",
  "description": "Offline arrangement workspace for EP-133 KO II",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --outfile=dist/app.js",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "package": "npm run build && node scripts/package.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "esbuild": "^0.28.2"
  }
}
